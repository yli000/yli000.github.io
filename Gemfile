# Local development only — mirrors the GitHub Pages build environment, so your
# local preview matches the live site. Preview with:
#
#   bundle install
#   bundle exec jekyll serve
#
source "https://rubygems.org"

# The github-pages gem pins Jekyll + plugins (including jekyll-remote-theme) to
# the exact versions GitHub Pages uses to build your site. Don't add a separate
# `gem "jekyll"` line — it conflicts with what github-pages requires.
gem "github-pages", group: :jekyll_plugins

# Ruby 3+ no longer ships webrick in its standard library; `jekyll serve` needs it.
gem "webrick"
